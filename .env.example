# Salin ke .env.local lalu sesuaikan bila perlu.

# Base URL API untuk frontend (dibaca browser).
#  - "/bff"  → lewat proxy same-origin (next.config.ts rewrites) — hindari CORS saat dev.
#  - Untuk hit API langsung (butuh CORS aktif di backend): isi origin penuh, mis.
#    https://dev.api.temantumbuh.czn.my.id
NEXT_PUBLIC_API_URL=/bff

# Origin API tujuan proxy (dipakai next.config.ts di sisi server saja).
API_PROXY_TARGET=https://dev.api.temantumbuh.czn.my.id

